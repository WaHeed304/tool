{
  "framework": null,
  "installCommand": "echo 'skip install'",
  "buildCommand": "node html-static-site/_gen-tool-categories.js",
  "outputDirectory": "html-static-site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tools/seo", "destination": "/tools" },
    { "source": "/tools/content", "destination": "/tools" },
    { "source": "/tools/design", "destination": "/tools" },
    { "source": "/tools/amazon", "destination": "/tools" },
    { "source": "/tools/ai", "destination": "/tools" }
  ]
}
