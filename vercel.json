{
  "framework": null,
  "installCommand": "echo 'skip install'",
  "buildCommand": "echo 'static html-static-site'",
  "outputDirectory": "html-static-site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tools/seo", "destination": "/tools.html" },
    { "source": "/tools/content", "destination": "/tools.html" },
    { "source": "/tools/design", "destination": "/tools.html" },
    { "source": "/tools/amazon", "destination": "/tools.html" },
    { "source": "/tools/ai", "destination": "/tools.html" }
  ]
}
